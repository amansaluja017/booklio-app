{
  "compilerOptions": {
    "target": "esnext",
    "module": "NODENEXT",
    "lib": ["ES2020"],
    "outDir": "dist",
    "rootDir": "..",
    "paths": {
      "models/*": ["./models/*"],
    },
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
  },
  "include": ["**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
