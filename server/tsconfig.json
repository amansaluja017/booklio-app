{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "lib": ["ES2020"],
    "outDir": "dist",
    "rootDir": "..",
    "baseUrl": "..",
    "paths": {
      "models/*": ["models/*"],
      "validations/*": ["validations/*"]
    },
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "moduleResolution": "node"
  },
  "include": ["**/*.ts", "../validations/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
